{
  "index_patterns": [
    "gdelt-mentions-v1-p*-g*"
  ],
  "priority": 100,
  "version": 1,
  "allow_auto_create": false,
  "template": {
    "mappings": {
      "dynamic": "strict",
      "_meta": {
        "schema_version": 1
      },
      "properties": {
        "rawMentionId": {
          "type": "keyword",
          "doc_values": true
        },
        "sourceDocumentKey": {
          "type": "keyword",
          "doc_values": true
        },
        "globalEventId": {
          "type": "long"
        },
        "eventTimeDate": {
          "type": "date"
        },
        "mentionTimeDate": {
          "type": "date",
          "doc_values": true
        },
        "mentionType": {
          "type": "integer"
        },
        "mentionSourceName": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "mentionIdentifier": {
          "type": "keyword",
          "ignore_above": 8191
        },
        "sentenceId": {
          "type": "integer"
        },
        "actor1CharOffset": {
          "type": "integer"
        },
        "actor2CharOffset": {
          "type": "integer"
        },
        "actionCharOffset": {
          "type": "integer"
        },
        "inRawText": {
          "type": "integer"
        },
        "confidence": {
          "type": "integer"
        },
        "mentionDocLen": {
          "type": "integer"
        },
        "mentionDocTone": {
          "type": "double"
        },
        "mentionDocTranslationInfo": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "extras": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "sourceUpdateTime": {
          "type": "date"
        },
        "sourceArchiveKey": {
          "type": "keyword",
          "doc_values": true
        },
        "sourceLineNumber": {
          "type": "long",
          "doc_values": true
        },
        "processingFingerprint": {
          "type": "keyword",
          "doc_values": true
        }
      }
    }
  }
}
