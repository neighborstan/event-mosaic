{
  "index_patterns": [
    "gdelt-events-v1",
    "gdelt-events-v1-*-g*"
  ],
  "priority": 100,
  "version": 1,
  "allow_auto_create": false,
  "template": {
    "mappings": {
      "dynamic": "strict",
      "_meta": {
        "schema_version": 1
      },
      "properties": {
        "globalEventId": {
          "type": "long",
          "doc_values": true
        },
        "eventDay": {
          "type": "date"
        },
        "dateAdded": {
          "type": "date"
        },
        "actor1Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Name": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "actor1CountryCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1KnownGroupCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1EthnicCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Religion1Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Religion2Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Type1Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Type2Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor1Type3Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Name": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "actor2CountryCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2KnownGroupCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2EthnicCode": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Religion1Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Religion2Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Type1Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Type2Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "actor2Type3Code": {
          "type": "keyword",
          "ignore_above": 256
        },
        "isRootEvent": {
          "type": "integer"
        },
        "eventCode": {
          "type": "keyword",
          "ignore_above": 64
        },
        "eventBaseCode": {
          "type": "keyword",
          "ignore_above": 64
        },
        "eventRootCode": {
          "type": "keyword",
          "ignore_above": 64
        },
        "quadClass": {
          "type": "integer"
        },
        "goldsteinScale": {
          "type": "double"
        },
        "averageTone": {
          "type": "double"
        },
        "numMentions": {
          "type": "integer"
        },
        "numSources": {
          "type": "integer"
        },
        "numArticles": {
          "type": "integer"
        },
        "location": {
          "type": "object",
          "dynamic": "strict",
          "properties": {
            "role": {
              "type": "keyword"
            },
            "geoType": {
              "type": "integer"
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "countryCode": {
              "type": "keyword",
              "ignore_above": 32
            },
            "admin1Code": {
              "type": "keyword",
              "ignore_above": 64
            },
            "admin2Code": {
              "type": "keyword",
              "ignore_above": 64
            },
            "featureId": {
              "type": "keyword",
              "ignore_above": 256
            },
            "point": {
              "type": "geo_point"
            }
          }
        },
        "sourceUrl": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "sourceUpdateTime": {
          "type": "date"
        },
        "sourceArchiveKey": {
          "type": "keyword",
          "doc_values": true
        },
        "sourceLineNumber": {
          "type": "long",
          "doc_values": true
        },
        "processingFingerprint": {
          "type": "keyword",
          "doc_values": true
        }
      }
    }
  }
}
